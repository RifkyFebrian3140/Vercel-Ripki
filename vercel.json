
{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/alatkemah/(.*)$",
      "dest": "/api/alatkemah/$1"
    },
    {
      "src": "^/anggota/(.*)$",
      "dest": "/api/anggota/$1"
    }
  ]
}